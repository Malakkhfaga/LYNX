<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LYNX · AI + Cybersecurity Platform</title>
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <!-- Three.js for 3D graphics -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js">
    </script>
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        body {
            background: #080b10;
            color: #eef2f6;
            display: flex;
            justify-content: center;
            padding: 1.5rem 1rem;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .app-container {
            max-width: 1440px;
            width: 100%;
        }

        /* ----- GLASS & GLOBAL with 3D transforms ----- */
        .glass {
            background: rgba(14, 20, 30, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 30, 39, 0.12);
            border-radius: 28px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 30, 39, 0.06);
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
            perspective: 1000px;
        }

        .glass:hover {
            transform: translateY(-2px) scale(1.002);
            box-shadow: 0 35px 60px -15px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 30, 39, 0.15);
        }

        .accent-red {
            color: #FF1E27;
        }
        .bg-red {
            background: #FF1E27;
        }

        .btn-primary {
            background: #FF1E27;
            border: none;
            color: white;
            font-weight: 600;
            padding: 0.7rem 1.8rem;
            border-radius: 60px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 0 24px rgba(255, 30, 39, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.9rem;
            letter-spacing: 0.2px;
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.4s ease;
            transform: scale(0.5);
        }

        .btn-primary:hover::after {
            opacity: 1;
            transform: scale(1);
        }

        .btn-primary:hover {
            transform: scale(1.05) translateY(-2px);
            box-shadow: 0 0 45px rgba(255, 30, 39, 0.5);
        }

        .btn-primary i {
            font-size: 0.9rem;
            transition: transform 0.3s ease;
        }

        .btn-primary:hover i {
            transform: translateX(4px) rotate(-5deg);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #cbd5e1;
            font-weight: 500;
            padding: 0.7rem 1.8rem;
            border-radius: 60px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            font-size: 0.9rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-outline:hover {
            border-color: #FF1E27;
            color: white;
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 0 30px rgba(255, 30, 39, 0.1);
        }

        .badge-red {
            background: #FF1E27;
            color: white;
            font-size: 0.6rem;
            font-weight: 700;
            padding: 0.2rem 0.9rem;
            border-radius: 40px;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            animation: pulse-badge 2s infinite;
        }

        @keyframes pulse-badge {
            0%,
            100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.05);
            }
        }

        .badge-ghost {
            background: rgba(255, 30, 39, 0.12);
            color: #FF1E27;
            font-size: 0.6rem;
            font-weight: 600;
            padding: 0.2rem 0.9rem;
            border-radius: 40px;
            transition: all 0.3s ease;
        }

        .badge-ghost:hover {
            background: rgba(255, 30, 39, 0.2);
            transform: scale(1.05);
        }

        /* ----- NAVIGATION ----- */
        .top-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 2rem;
            flex-wrap: wrap;
            gap: 0.8rem 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            margin-bottom: 1.2rem;
        }

        .logo {
            font-weight: 700;
            font-size: 1.6rem;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: white;
            text-decoration: none;
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
        }

        .logo:hover {
            transform: scale(1.05) rotate(-2deg);
        }

        .logo i {
            color: #FF1E27;
            font-size: 2rem;
            filter: drop-shadow(0 0 8px rgba(255, 30, 39, 0.3));
            transition: transform 0.4s ease;
        }

        .logo:hover i {
            transform: rotate(-10deg) scale(1.1);
        }

        .nav-links {
            display: flex;
            gap: 1.8rem;
            font-weight: 500;
            color: #b0bac9;
            font-size: 0.9rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: inherit;
            text-decoration: none;
            padding: 0.2rem 0;
            border-bottom: 2px solid transparent;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
            position: relative;
        }

        .nav-links a::before {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 2px;
            background: #FF1E27;
            transition: width 0.3s ease;
        }

        .nav-links a:hover::before,
        .nav-links a.active::before {
            width: 100%;
        }

        .nav-links a:hover {
            color: #fff;
            transform: translateY(-1px);
        }

        .nav-links a.active {
            color: #FF1E27;
        }

        .login-btn {
            background: #FF1E27;
            padding: 0.3rem 1.4rem;
            border-radius: 40px;
            color: white;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
            box-shadow: 0 0 16px rgba(255, 30, 39, 0.2);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .login-btn:hover {
            transform: scale(1.08) translateY(-2px);
            box-shadow: 0 0 30px rgba(255, 30, 39, 0.4);
        }

        /* ----- PAGE CONTAINER ----- */
        .page-content {
            display: block;
        }
        .page-section {
            display: none;
            animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .page-section.active {
            display: block;
        }

        @keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(30px) scale(0.97);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ----- 3D Canvas Container ----- */
        #three-container {
            width: 100%;
            height: 200px;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            margin-bottom: 1rem;
            background: radial-gradient(ellipse at center, #0f1a26, #080b10);
            border: 1px solid rgba(255, 30, 39, 0.1);
        }

        #three-container canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
        }

        /* ----- HERO ----- */
        .hero-block {
            padding: 1rem 2rem 2rem 2rem;
            position: relative;
            overflow: hidden;
        }

        .hero-block::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 60%;
            height: 200%;
            background: radial-gradient(ellipse, rgba(255, 30, 39, 0.05) 0%, transparent 70%);
            pointer-events: none;
            animation: heroGlow 8s ease-in-out infinite alternate;
        }

        @keyframes heroGlow {
            0% {
                transform: translateX(-20px) scale(1);
            }
            100% {
                transform: translateX(40px) scale(1.1);
            }
        }

        .hero-title {
            font-size: 3.2rem;
            font-weight: 800;
            line-height: 1.05;
            letter-spacing: -1.5px;
            position: relative;
            z-index: 1;
        }

        .hero-title .highlight {
            background: linear-gradient(135deg, #FF1E27, #ff4d55, #FF1E27);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%,
            100% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
        }

        .hero-sub {
            color: #a6b3cc;
            font-size: 1.1rem;
            max-width: 520px;
            line-height: 1.7;
            margin: 0.8rem 0 1.2rem 0;
            position: relative;
            z-index: 1;
        }

        .feature-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem 3rem;
            margin-top: 1.8rem;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            padding-top: 1.8rem;
            position: relative;
            z-index: 1;
        }

        .chip-item {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            color: #ced9e8;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: default;
        }

        .chip-item:hover {
            transform: translateY(-3px) scale(1.05);
            color: white;
        }

        .chip-item i {
            color: #FF1E27;
            font-size: 1.3rem;
            width: 2rem;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .chip-item:hover i {
            transform: rotate(-10deg) scale(1.2);
        }

        /* ----- DASHBOARD ----- */
        .dash-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin: 1.2rem 0;
        }

        .dash-card {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 20px;
            padding: 1.2rem 1.2rem 0.8rem;
            border: 1px solid rgba(255, 255, 255, 0.04);
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: default;
            perspective: 600px;
            transform-style: preserve-3d;
        }

        .dash-card:hover {
            background: rgba(255, 30, 39, 0.04);
            border-color: rgba(255, 30, 39, 0.2);
            transform: translateY(-4px) scale(1.01) rotateX(2deg);
            box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.5);
        }

        .dash-card .title {
            font-weight: 600;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .dash-card .title i {
            color: #FF1E27;
            font-size: 1.2rem;
            width: 1.6rem;
            transition: transform 0.3s ease;
        }

        .dash-card:hover .title i {
            transform: scale(1.2) rotate(-5deg);
        }

        .dash-card .desc {
            font-size: 0.75rem;
            color: #8f9bb3;
            margin: 0.4rem 0 0.8rem 0;
            line-height: 1.4;
        }

        .dash-card .link {
            color: #FF1E27;
            font-weight: 600;
            font-size: 0.8rem;
            letter-spacing: 0.3px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            background: none;
            border: none;
            padding: 0;
            transition: all 0.3s ease;
        }

        .dash-card .link:hover {
            transform: translateX(6px);
            color: #ff4d55;
        }

        .activity-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1.8rem 2.5rem;
            border-top: 1px solid #1c2738;
            padding-top: 1.2rem;
            margin-top: 0.8rem;
        }

        .activity-row .label {
            color: #8fa0bb;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .activity-row .value {
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .project-tag {
            background: rgba(255, 30, 39, 0.12);
            padding: 0.1rem 0.7rem;
            border-radius: 40px;
            font-size: 0.6rem;
            font-weight: 600;
            color: #FF1E27;
            margin-left: 0.4rem;
            animation: pulse-badge 2s infinite;
        }

        /* ----- SCANNER ----- */
        .scanner-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin-top: 0.5rem;
        }

        .scanner-circle {
            width: 100%;
            aspect-ratio: 1/1;
            max-width: 200px;
            margin: 0.2rem auto 0.8rem auto;
            background: radial-gradient(circle at 30% 30%, #1f2a3a, #080c14);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #FF1E27;
            box-shadow: 0 0 60px rgba(255, 30, 39, 0.25), inset 0 0 80px rgba(255, 30, 39, 0.05);
            position: relative;
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            transform-style: preserve-3d;
            cursor: pointer;
        }

        .scanner-circle:hover {
            transform: scale(1.05) rotateY(5deg) rotateX(3deg);
            box-shadow: 0 0 80px rgba(255, 30, 39, 0.35);
        }

        .scanner-circle .pulse-ring {
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 1px solid rgba(255, 30, 39, 0.1);
            animation: pulse-ring 2s ease-out infinite;
        }

        .scanner-circle .pulse-ring:nth-child(2) {
            animation-delay: 1s;
        }

        @keyframes pulse-ring {
            0% {
                transform: scale(1);
                opacity: 0.8;
            }
            100% {
                transform: scale(1.4);
                opacity: 0;
            }
        }

        .scanner-circle i {
            font-size: 4.5rem;
            color: #FF1E27;
            opacity: 0.9;
            transform: rotate(15deg);
            filter: drop-shadow(0 0 20px rgba(255, 30, 39, 0.3));
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%,
            100% {
                transform: rotate(15deg) translateY(0);
            }
            50% {
                transform: rotate(15deg) translateY(-8px);
            }
        }

        .scanner-input {
            display: flex;
            gap: 0.5rem;
            margin: 0.6rem 0 1.2rem 0;
            flex-wrap: wrap;
        }

        .scanner-input input {
            flex: 1;
            background: #111b24;
            border: 1px solid #2a3546;
            border-radius: 60px;
            padding: 0.7rem 1.4rem;
            color: white;
            outline: none;
            min-width: 150px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        .scanner-input input:focus {
            border-color: #FF1E27;
            box-shadow: 0 0 30px rgba(255, 30, 39, 0.1);
        }

        .scanner-features {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
        }

        .scanner-feat {
            background: #111a22;
            border-radius: 40px;
            padding: 0.4rem 1.2rem 0.4rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid #293545;
            font-size: 0.75rem;
            font-weight: 500;
            color: #c6d2e5;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: default;
        }

        .scanner-feat:hover {
            transform: translateY(-3px) scale(1.03);
            border-color: #FF1E27;
            background: #141f2b;
        }

        .scanner-feat i {
            color: #FF1E27;
            transition: transform 0.3s ease;
        }

        .scanner-feat:hover i {
            transform: rotate(-10deg) scale(1.2);
        }

        /* ----- COURSES ----- */
        .course-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.9rem;
        }

        .course-card {
            background: #0f1822;
            border-radius: 20px;
            padding: 0.9rem;
            border: 1px solid #1f2b39;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            transform-style: preserve-3d;
            perspective: 500px;
            cursor: pointer;
        }

        .course-card:hover {
            border-color: #FF1E27;
            background: #121d29;
            transform: translateY(-6px) rotateX(3deg) scale(1.02);
            box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.6);
        }

        .course-card .thumb {
            height: 70px;
            background: #17222f;
            border-radius: 14px;
            margin-bottom: 0.6rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FF1E27;
            font-size: 1.8rem;
            border: 1px solid #253242;
            transition: all 0.3s ease;
        }

        .course-card:hover .thumb {
            border-color: #FF1E27;
            background: #1a2737;
            transform: scale(1.02);
        }

        .course-card h4 {
            font-size: 0.85rem;
            font-weight: 600;
        }

        .course-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: #8b9bb5;
            margin-top: 0.3rem;
        }

        .course-meta .stars {
            color: #FF1E27;
        }

        .course-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem 1.5rem;
            margin: 0.8rem 0 1.2rem 0;
            border-bottom: 1px solid #1a2533;
            padding-bottom: 0.6rem;
        }

        .filter-item {
            font-size: 0.8rem;
            font-weight: 500;
            color: #99a8c0;
            cursor: pointer;
            padding: 0.2rem 0.2rem;
            border-bottom: 2px solid transparent;
            transition: all 0.3s ease;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
        }

        .filter-item.active,
        .filter-item:hover {
            color: #FF1E27;
            border-bottom-color: #FF1E27;
        }

        /* ----- MESSAGING ----- */
        .messaging-grid {
            display: grid;
            grid-template-columns: 1.2fr 1.8fr 1.8fr;
            gap: 1rem;
            margin-top: 0.5rem;
        }

        .contact-list {
            background: #0c141e;
            border-radius: 22px;
            padding: 0.8rem 0.6rem;
            border: 1px solid #1b2737;
            transition: all 0.3s ease;
        }

        .contact-list:hover {
            border-color: rgba(255, 30, 39, 0.2);
        }

        .contact-item {
            padding: 0.6rem 0.5rem;
            border-bottom: 1px solid #1a2533;
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            align-items: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .contact-item:hover {
            background: rgba(255, 30, 39, 0.04);
            border-radius: 12px;
            padding-left: 0.8rem;
        }

        .contact-item:last-child {
            border-bottom: none;
        }

        .contact-item .status {
            color: #4cd9a0;
            font-size: 0.65rem;
            font-weight: 500;
        }
        .contact-item .status.offline {
            color: #7f8fa8;
        }
        .contact-item i.fa-circle {
            font-size: 0.45rem;
            margin-right: 0.4rem;
        }

        .chat-thread {
            background: #0c141e;
            border-radius: 22px;
            padding: 0.8rem 0.9rem;
            border: 1px solid #1b2737;
            transition: all 0.3s ease;
        }

        .chat-thread:hover {
            border-color: rgba(255, 30, 39, 0.15);
        }

        .msg {
            background: #1a2636;
            border-radius: 16px 16px 16px 4px;
            padding: 0.6rem 1rem;
            margin-bottom: 0.6rem;
            max-width: 80%;
            font-size: 0.8rem;
            line-height: 1.4;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
            transform-origin: left;
        }

        .msg:hover {
            transform: scale(1.02);
        }

        .msg.own {
            background: #FF1E27;
            color: white;
            margin-left: auto;
            border-radius: 16px 16px 4px 16px;
            box-shadow: 0 0 30px rgba(255, 30, 39, 0.15);
            transform-origin: right;
        }

        .msg.own:hover {
            transform: scale(1.02);
            box-shadow: 0 0 40px rgba(255, 30, 39, 0.25);
        }

        .msg-time {
            font-size: 0.5rem;
            color: #7f8ea8;
            text-align: right;
            margin-top: 0.15rem;
        }
        .msg.own .msg-time {
            color: rgba(255, 255, 255, 0.6);
        }

        .chat-input {
            display: flex;
            margin-top: 0.8rem;
            gap: 0.3rem;
        }

        .chat-input input {
            flex: 1;
            background: #18222f;
            border: none;
            border-radius: 40px;
            padding: 0.6rem 1.2rem;
            color: white;
            outline: none;
            font-size: 0.8rem;
            transition: all 0.3s ease;
        }

        .chat-input input:focus {
            background: #1e2a3a;
            box-shadow: 0 0 20px rgba(255, 30, 39, 0.05);
        }

        .chat-input .send-btn {
            background: #FF1E27;
            border-radius: 40px;
            padding: 0 1.2rem;
