            border-radius: 16px;
            border-left: 3px solid #FF1E27;
            line-height: 1.5;
        }

        .result-card .warning-note i {
            color: #FF1E27;
            margin-right: 0.4rem;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            padding: 0 2rem 1.5rem 2rem;
        }

        .step-item {
            background: rgba(12, 18, 26, 0.4);
            border-radius: 20px;
            padding: 1.2rem;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.03);
            transition: all 0.3s ease;
            cursor: default;
        }

        .step-item:hover {
            transform: translateY(-4px);
            border-color: rgba(255, 30, 39, 0.15);
            background: rgba(12, 18, 26, 0.6);
        }

        .step-item .step-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 30, 39, 0.1);
            color: #FF1E27;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 0.6rem;
            transition: all 0.3s ease;
        }

        .step-item:hover .step-num {
            background: #FF1E27;
            color: white;
            transform: scale(1.1);
        }

        .step-item h4 {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.2rem;
        }

        .step-item p {
            font-size: 0.7rem;
            color: #8f9bb3;
            line-height: 1.4;
        }

        .algo-grid {
            display: flex;
            gap: 1.5rem;
            padding: 0 2rem 1.5rem 2rem;
            flex-wrap: wrap;
        }

        .algo-card {
            background: rgba(12, 18, 26, 0.4);
            border-radius: 20px;
            padding: 0.8rem 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.03);
            display: flex;
            align-items: center;
            gap: 0.8rem;
            transition: all 0.3s ease;
            cursor: default;
        }

        .algo-card:hover {
            border-color: rgba(255, 30, 39, 0.2);
            transform: translateY(-2px);
        }

        .algo-card .algo-name {
            font-weight: 600;
            font-size: 0.85rem;
        }

        .algo-card .algo-badge {
            font-size: 0.6rem;
            color: #4cd9a0;
            background: rgba(76, 217, 160, 0.08);
            padding: 0.1rem 0.6rem;
            border-radius: 40px;
        }

        /* ----- HELP FOOTER ----- */
        .help-footer {
            margin-top: 1.2rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            background: #0a111b;
            border-radius: 30px;
            padding: 0.7rem 1.6rem;
            font-size: 0.8rem;
            border: 1px solid #1e293b;
            gap: 0.8rem;
            transition: all 0.3s ease;
        }

        .help-footer:hover {
            border-color: rgba(255, 30, 39, 0.15);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3);
        }

        .help-footer i {
            color: #FF1E27;
            margin-right: 0.4rem;
            width: 1.2rem;
            transition: transform 0.3s ease;
        }

        .help-footer span:hover i {
            transform: scale(1.2) rotate(-5deg);
        }

        .help-footer span {
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
            cursor: default;
        }

        .help-footer span:hover {
            color: white;
            transform: translateY(-1px);
        }

        /* ----- Toggle switch ----- */
        .toggle-switch {
            width: 44px;
            height: 24px;
            background: #1e2a3a;
            border-radius: 40px;
            position: relative;
            border: 1px solid #33445a;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .toggle-switch .toggle-knob {
            position: absolute;
            width: 18px;
            height: 18px;
            background: #FF1E27;
            border-radius: 50%;
            top: 2px;
            left: 2px;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 0 16px rgba(255, 30, 39, 0.3);
        }

        .toggle-switch:hover .toggle-knob {
            transform: scale(1.1);
        }

        .toggle-switch.active .toggle-knob {
            left: 22px;
            background: #4cd9a0;
            box-shadow: 0 0 16px rgba(76, 217, 160, 0.3);
        }

        /* ----- Toast Notification ----- */
        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: rgba(14, 20, 30, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 30, 39, 0.2);
            border-radius: 16px;
            padding: 1rem 1.5rem;
            color: white;
            font-size: 0.9rem;
            box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.8);
            transform: translateY(120px);
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 9999;
            max-width: 400px;
            pointer-events: none;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .toast i {
            color: #FF1E27;
            margin-right: 0.6rem;
        }

        /* ----- Modal ----- */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            animation: fadeIn 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
        }

        @keyframes fadeIn {
            0% {
                opacity: 0;
            }
            100% {
                opacity: 1;
            }
        }

        .modal-content {
            background: #0f1a26;
            border: 1px solid rgba(255, 30, 39, 0.2);
            border-radius: 28px;
            padding: 2.5rem;
            max-width: 500px;
            width: 90%;
            box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.9);
            animation: modalSlide 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @keyframes modalSlide {
            0% {
                transform: scale(0.9) translateY(30px);
                opacity: 0;
            }
            100% {
                transform: scale(1) translateY(0);
                opacity: 1;
            }
        }

        .modal-content h2 {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .modal-content p {
            color: #a6b3cc;
            margin-bottom: 1.2rem;
            line-height: 1.6;
        }

        .modal-content .close-modal {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #a6b3cc;
            padding: 0.5rem 1.5rem;
            border-radius: 40px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .modal-content .close-modal:hover {
            border-color: #FF1E27;
            color: white;
        }

        /* ----- Responsive ----- */
        @media (max-width: 1000px) {
            .dash-grid {
                grid-template-columns: 1fr;
            }
            .course-grid {
                grid-template-columns: 1fr;
            }
            .messaging-grid {
                grid-template-columns: 1fr 1fr;
            }
            .pricing-grid {
                grid-template-columns: 1fr 1fr;
            }
            .encrypt-grid {
                grid-template-columns: 1fr;
            }
            .steps-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 700px) {
            .messaging-grid {
                grid-template-columns: 1fr;
            }
            .pricing-grid {
                grid-template-columns: 1fr;
            }
            .steps-grid {
                grid-template-columns: 1fr;
            }
            .hero-title {
                font-size: 2rem;
            }
            .nav-links {
                gap: 0.8rem;
                font-size: 0.8rem;
            }
            .top-nav {
                padding: 0.5rem 1rem;
            }
            .scanner-wrapper {
                flex-direction: column;
            }
            .encrypt-grid {
                padding: 0 1rem 1rem 1rem;
            }
            .steps-grid {
                padding: 0 1rem 1.5rem 1rem;
            }
            .algo-grid {
                padding: 0 1rem 1.5rem 1rem;
            }
        }
    </style>
</head>
