            font-size: 0.7rem;
            color: #4c5d73;
            margin-top: -0.4rem;
            margin-bottom: 0.8rem;
        }

        .algorithm-selector {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .algo-option {
            background: #0f1822;
            border: 1px solid #1f2b39;
            border-radius: 40px;
            padding: 0.4rem 1.2rem;
