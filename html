        .algo-option:hover {
            border-color: #FF1E27;
            color: white;
        }

        .algo-option.active {
            border-color: #FF1E27;
            background: rgba(255, 30, 39, 0.1);
            color: #FF1E27;
        }

        .result-card {
            background: rgba(12, 18, 26, 0.6);
            border-radius: 24px;
            padding: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        .result-card .success-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(76, 217, 160, 0.12);
            color: #4cd9a0;
            padding: 0.3rem 1rem;
            border-radius: 40px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .result-card .success-badge i {
            font-size: 0.9rem;
        }

        .result-card .label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #7f8fa8;
            margin-bottom: 0.3rem;
        }

        .result-card .encrypted-text {
            background: #0a111b;
            border-radius: 16px;
            padding: 1rem;
            font-family: 'Courier New', monospace;
            font-size: 0.75rem;
            color: #b7c5dd;
            word-break: break-all;
            border: 1px solid #1a2533;
            margin-bottom: 1rem;
            line-height: 1.6;
        }

        .result-card .key-display {
            background: #0a111b;
            border-radius: 16px;
            padding: 0.7rem 1rem;
            font-family: 'Courier New', monospace;
            font-size: 0.8rem;
            color: #FF1E27;
            border: 1px solid rgba(255, 30, 39, 0.15);
            margin-bottom: 1rem;
            word-break: break-all;
        }

        .result-card .warning-note {
            font-size: 0.7rem;
            color: #7f8fa8;
            background: rgba(255, 30, 39, 0.05);
